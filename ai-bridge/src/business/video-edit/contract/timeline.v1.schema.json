{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "galaxy/video-edit/timeline.v1",
  "title": "video.edit.render 时间线",
  "type": "object",
  "required": ["timeline"],
  "properties": {
    "timeline": {
      "type": "object",
      "required": ["clips"],
      "properties": {
        "tracks": { "type": "array", "items": { "type": "object" } },
        "clips": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["src"],
            "properties": {
              "src": {
                "description": "素材的 OSS 引用。job 的输入全部走引用，Hub 不经手字节。",
                "type": "object",
                "required": ["store", "key"],
                "properties": {
                  "store": { "type": "string" },
                  "key": { "type": "string" },
                  "size": { "type": "integer" },
                  "contentType": { "type": "string" }
                }
              },
              "in": { "description": "入点秒", "type": "number", "minimum": 0 },
              "out": { "description": "出点秒", "type": "number", "minimum": 0 },
              "effects": { "type": "array", "items": { "type": "object" } }
            }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "properties": {
        "codec": { "type": "string", "default": "h264" },
        "resolution": { "type": "string", "examples": ["1920x1080", "1280x720"] },
        "fps": { "type": "number" }
      }
    },
    "subtitles": { "type": "object" },
    "space": { "type": "string" }
  },
  "additionalProperties": true
}

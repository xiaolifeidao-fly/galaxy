{
  "name": "ai-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Local bridge service for Claude Code / Codex: relays Anthropic Messages and OpenAI Responses through a subscription login, with token auth, scopes and pluggable modules.",
  "type": "module",
  "main": "dist/main.js",
  "bin": {
    "ai-bridge": "dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js start",
    "dev": "tsx watch src/main.ts start",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.21.0",
    "js-yaml": "^4.1.0",
    "p-queue": "^8.0.1",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.175",
    "@openai/codex-sdk": "^0.139.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
